---
interface Props {
  title: string;
  slug: string;
  content: string;
  thumbnail: {
    responsiveImage?: {
      src?: string;
      srcSet?: string;
      sizes?: string;
      width?: number;
      height?: number;
      alt?: string;
    };
  };
  tags?: string[] | string;
  delay?: number | string;
}

import { Icon } from "astro-icon/components";

const { title, thumbnail, slug, content, tags, delay = 0 } = Astro.props;

const parseTags = (tags?: string[] | string): string[] => {
  if (!tags) return [];
  if (Array.isArray(tags))
    return tags.map((t) => String(t).trim()).filter(Boolean);
  if (typeof tags === "string") {
    return tags
      .split(/[,;\n]+/)
      .map((t) => t.trim())
      .filter((t) => t.length > 0);
  }
  return [];
};

const parsedTags = parseTags(tags);
const plainText = content
  ? content.replace(/[#*`_\[\]]/g, "").slice(0, 140) + "..."
  : "";
const imgSrc = thumbnail?.responsiveImage?.src || "/placeholder.svg";
---

<article
  data-animate="fade-up"
  data-animate-delay={String(delay)}
  class="group flex flex-col bg-limestone dark:bg-[#141314] rounded-[40px] p-6 sm:p-8 border border-obsidian/10 dark:border-white/10 transition-transform hover:-translate-y-1.5 duration-300"
>
  <div
    class="relative w-full h-52 rounded-[28px] overflow-hidden bg-obsidian/5 dark:bg-obsidian skeleton-shimmer mb-6"
  >
    <a
      href={`/blog/${slug}`}
      class="block w-full h-full"
      aria-label={`Leer artículo: ${title}`}
    >
      <img
        src={imgSrc}
        alt={thumbnail?.responsiveImage?.alt || title}
        class="lazy-img w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
        loading="lazy"
        decoding="async"
        onload="this.classList.add('loaded')"
      />
    </a>
    {
      parsedTags.length > 0 ? (
        <div class="absolute top-3 left-3 flex flex-wrap gap-1.5 z-10">
          {parsedTags.map((tag) => (
            <span class="px-3 py-1 text-xs font-medium rounded-full bg-sulfur text-obsidian">
              {tag}
            </span>
          ))}
        </div>
      ) : (
        <span class="absolute top-3 left-3 px-3 py-1 text-xs font-medium rounded-full bg-sulfur text-obsidian">
          Artículo
        </span>
      )
    }
  </div>

  <div class="flex-1 flex flex-col justify-between space-y-4">
    <div class="space-y-3">
      <h2 class="display-title text-2xl sm:text-3xl uppercase text-obsidian dark:text-chalk group-hover:text-ember transition-colors line-clamp-2">
        <a href={`/blog/${slug}`}>
          {title}
        </a>
      </h2>
      <p class="text-sm text-obsidian/75 dark:text-limestone/75 line-clamp-3 leading-relaxed font-medium">
        {plainText}
      </p>
    </div>

    <div
      class="pt-4 border-t border-dotted border-obsidian/15 dark:border-white/15 flex items-center justify-between text-xs text-obsidian/60 dark:text-limestone/60"
    >
      <div class="flex items-center space-x-1.5 font-medium">
        <Icon name="lucide:user" class="w-3.5 h-3.5 text-ember" />
        <span>Emamut</span>
      </div>
      <a
        href={`/blog/${slug}`}
        class="inline-flex items-center gap-1.5 font-medium text-xs text-obsidian dark:text-limestone hover:text-ember dark:hover:text-ember transition-colors"
      >
        <span>Leer artículo</span>
        <Icon name="lucide:arrow-right" class="w-3.5 h-3.5 text-ember" />
      </a>
    </div>
  </div>
</article>
