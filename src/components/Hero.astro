---
import { Icon } from "astro-icon/components";

const stats = [
  { label: "CÓDIGO A MEDIDA", value: "100%", isEmber: true },
  { label: "DISPONIBILIDAD Y RENDIMIENTO", value: "99.9%", isEmber: true },
  { label: "PROYECTOS DESARROLLADOS", value: "+50", isEmber: true },
  { label: "SOPORTE Y ARQUITECTURA", value: "24/7", isEmber: false },
];

const techStack = [
  { name: "Astro", icon: "simple-icons:astro" },
  { name: "React", icon: "simple-icons:react" },
  { name: "TypeScript", icon: "simple-icons:typescript" },
  { name: "Next.js", icon: "simple-icons:nextdotjs" },
  { name: "Node.js", icon: "simple-icons:nodedotjs" },
  { name: "Tailwind CSS", icon: "simple-icons:tailwindcss" },
  { name: "Cloud & DevOps", icon: "simple-icons:amazonwebservices" },
];
---

<section id="hero" class="pt-32 sm:pt-36 pb-16 transition-colors relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
    <!-- Hero Main Grid -->
    <div class="grid lg:grid-cols-12 gap-10 lg:gap-12 items-center">
      <!-- Left Content (7 cols) -->
      <div class="lg:col-span-7 space-y-8 text-left">
        <!-- Tag / Category Badge (Sulfur pill) -->
        <div data-animate="fade-down">
          <div
            class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-sulfur text-obsidian text-xs font-medium tracking-wider uppercase"
          >
            <span class="w-2 h-2 rounded-full bg-ember animate-ping"></span>
            Emamut &middot; Software & Soluciones Digitales
          </div>
        </div>

        <!-- Compressed Display Headline (PP Neue Corp Compact / Anton / Bebas Neue scale) -->
        <div class="space-y-4" data-animate="fade-up" data-animate-delay="100">
          <h1
            class="display-title text-5xl sm:text-7xl md:text-8xl lg:text-[96px] xl:text-[112px] uppercase text-obsidian dark:text-chalk leading-[0.92]"
          >
            Software <span class="text-ember">a medida</span>
            <br />
            para tu negocio
          </h1>
          <p
            class="text-base sm:text-lg lg:text-xl text-obsidian/80 dark:text-limestone/85 leading-relaxed max-w-2xl font-medium"
          >
            En <span class="text-obsidian dark:text-chalk font-bold">Emamut</span> transformamos
            ideas en plataformas digitales de alto impacto. Desarrollamos software a
            medida, aplicaciones web y móviles con arquitectura sólida, rendimiento
            impecable y diseño vanguardista.
          </p>
        </div>

        <!-- Actions (Primary Filled Ember Pill + Secondary Outlined Pill) -->
        <div
          class="flex flex-wrap gap-4 items-center pt-2"
          data-animate="fade-up"
          data-animate-delay="200"
        >
          <a
            href="#portfolio"
            class="inline-flex items-center justify-center gap-2.5 px-8 py-3.5 rounded-full font-medium text-base bg-ember hover:bg-ember-dark text-obsidian transition-transform hover:scale-105 active:scale-100"
          >
            <span>Ver Portfolio</span>
            <Icon name="lucide:arrow-right" class="w-4 h-4" />
          </a>
          <a
            href="#contact"
            class="inline-flex items-center justify-center gap-2.5 px-8 py-3.5 rounded-full font-medium text-base border-[1.5px] border-obsidian dark:border-limestone text-obsidian dark:text-limestone hover:bg-obsidian hover:text-chalk dark:hover:bg-limestone dark:hover:text-obsidian transition-colors"
          >
            <span>Iniciar Proyecto</span>
            <Icon name="lucide:arrow-up-right" class="w-4 h-4" />
          </a>
        </div>
      </div>

      <!-- Right Signature Halftone Block (5 cols) -->
      <div
        class="lg:col-span-5 w-full"
        data-animate="zoom-in"
        data-animate-delay="250"
      >
        <div
          class="relative w-full rounded-[40px] overflow-hidden caldera-halftone p-8 sm:p-10 min-h-[420px] flex flex-col justify-between border border-obsidian/10"
        >
          <!-- Top Badge inside Halftone block -->
          <div class="flex items-center justify-between">
            <span
              class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-limestone text-obsidian text-xs font-mono font-medium"
            >
              <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
              core-production.ts
            </span>
            <span class="text-xs font-mono uppercase text-chalk/90 tracking-wider">
              v2.4 &middot; LIVE
            </span>
          </div>

          <!-- Central Code / Metric Window (Flat Limestone / Obsidian card) -->
          <div
            class="my-6 bg-obsidian/92 backdrop-blur-md rounded-[28px] p-6 text-chalk space-y-3.5 border border-chalk/10"
          >
            <div class="flex items-center justify-between border-b border-chalk/15 pb-2.5">
              <div class="flex items-center space-x-2">
                <span class="w-2.5 h-2.5 rounded-full bg-ember"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-sulfur"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-plasma-violet"></span>
              </div>
              <span class="text-[11px] font-mono text-sulfur font-semibold tracking-wider">
                99.9% UPTIME
              </span>
            </div>

            <div class="font-mono text-xs sm:text-sm space-y-1.5 text-chalk/90 pt-1">
              <p>
                <span class="text-ember font-semibold">const</span> studio = <span class="text-sulfur">"Emamut"</span>;
              </p>
              <p>
                <span class="text-ember font-semibold">const</span> architecture = <span class="text-sulfur">"Cloud Native"</span>;
              </p>
              <p class="text-chalk/60 text-xs">
                // Soluciones de alta fidelidad sin compromisos
              </p>
            </div>
          </div>

          <!-- Bottom Footer Status -->
          <div
            class="flex items-center justify-between text-xs text-chalk font-mono pt-2 border-t border-chalk/20"
          >
            <span class="flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
              Servidor Activo
            </span>
            <span class="bg-sulfur text-obsidian px-3 py-1 rounded-full font-sans font-medium text-xs">
              Latencia &lt; 35ms
            </span>
          </div>
        </div>
      </div>
    </div>

    <!-- Caldera Stat Row (Prompt #2 from DESIGN.md: Four cards, 40px radius, 40px padding) -->
    <div
      class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6"
      data-animate="fade-up"
      data-animate-delay="150"
    >
      {
        stats.map((stat) => (
          <div
            class:list={[
              "rounded-[40px] p-8 md:p-10 flex flex-col justify-between min-h-[200px] transition-transform hover:-translate-y-1",
              stat.isEmber
                ? "bg-ember text-chalk"
                : "bg-limestone dark:bg-[#141314] text-obsidian dark:text-chalk border border-obsidian/10 dark:border-white/10",
            ]}
          >
            <span
              class:list={[
                "text-xs font-semibold tracking-wider uppercase font-body",
                stat.isEmber ? "text-chalk/85" : "text-obsidian/70 dark:text-limestone/70",
              ]}
            >
              {stat.label}
            </span>
            <span class="display-title text-6xl sm:text-7xl lg:text-[76px] leading-none pt-4">
              {stat.value}
            </span>
          </div>
        ))
      }
    </div>

    <!-- Partner / Ecosystem Logo Strip (DESIGN.md Partner Logo Strip: Limestone card, 40px radius, dotted dividers) -->
    <div
      class="bg-limestone dark:bg-[#141314] rounded-[40px] p-8 sm:p-10 border border-obsidian/10 dark:border-white/10"
      data-animate="fade-up"
      data-animate-delay="200"
    >
      <div class="flex flex-col lg:flex-row items-center justify-between gap-6">
        <span class="text-xs font-semibold uppercase tracking-widest text-obsidian/60 dark:text-limestone/60 shrink-0 font-body">
          TECNOLOGÍAS DE PRIMER NIVEL
        </span>
        <div class="flex flex-wrap items-center justify-center lg:justify-end gap-x-6 gap-y-4 text-obsidian dark:text-limestone">
          {
            techStack.map((tech, idx) => (
              <div class="flex items-center gap-6">
                <div class="flex items-center gap-2 text-sm font-medium">
                  <Icon name={tech.icon} class="w-4 h-4 text-ember shrink-0" />
                  <span>{tech.name}</span>
                </div>
                {idx < techStack.length - 1 && (
                  <span
                    class="hidden md:block h-4 w-0 border-l-[1.5px] border-dotted border-obsidian/30 dark:border-white/30"
                    aria-hidden="true"
                  ></span>
                )}
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
