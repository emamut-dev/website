---
import { Icon } from 'astro-icon/components';
---

<section
  id="hero"
  class="pt-32 pb-20 md:pt-36 md:pb-24 bg-gradient-to-br from-gray-50 via-white to-orange-50/30 dark:from-gray-900 dark:via-gray-800/80 dark:to-gray-900 transition-colors relative overflow-hidden"
>
  <!-- Background decorative elements -->
  <div class="absolute -top-40 -right-40 w-96 h-96 bg-emamut-orange/10 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute -bottom-20 -left-20 w-80 h-80 bg-orange-400/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <!-- Left Content -->
      <div class="space-y-8 text-center lg:text-left">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emamut-orange/10 text-emamut-orange text-xs font-semibold tracking-wide uppercase">
          <span class="w-2 h-2 rounded-full bg-emamut-orange animate-ping"></span>
          Software & Soluciones Digitales
        </div>

        <div class="space-y-4">
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-gray-900 dark:text-white leading-[1.12] tracking-tight">
            Soluciones <span class="text-emamut-orange">Tecnológicas</span> Innovadoras
          </h1>
          <p class="text-lg sm:text-xl text-gray-600 dark:text-gray-300 leading-relaxed max-w-2xl mx-auto lg:mx-0">
            En <span class="font-semibold text-emamut-orange">Emamut</span> transformamos ideas en realidades digitales. Desarrollamos software a medida, aplicaciones web y móviles que impulsan el crecimiento de tu negocio.
          </p>
        </div>

        <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
          <a
            href="#portfolio"
            class="inline-flex items-center justify-center gap-2 px-8 py-3.5 rounded-xl font-semibold text-sm bg-emamut-orange hover:bg-emamut-orange-dark text-white shadow-lg shadow-orange-500/25 hover:shadow-orange-500/40 hover:-translate-y-0.5 transition-all duration-200"
          >
            <span>Ver Portfolio</span>
            <Icon name="lucide:arrow-right" class="w-4 h-4" />
          </a>
          <a
            href="#contact"
            class="inline-flex items-center justify-center gap-2 px-8 py-3.5 rounded-xl font-semibold text-sm border-2 border-emamut-orange text-emamut-orange hover:bg-emamut-orange hover:text-white dark:border-emamut-orange dark:text-emamut-orange hover:-translate-y-0.5 transition-all duration-200"
          >
            <span>Contactar</span>
            <Icon name="lucide:message-square" class="w-4 h-4" />
          </a>
        </div>
      </div>

      <!-- Right Code / App Showcase Card -->
      <div class="relative max-w-lg mx-auto lg:max-w-none w-full">
        <div class="absolute -inset-2 bg-gradient-to-r from-emamut-orange to-orange-400 rounded-3xl blur-xl opacity-30 dark:opacity-40 animate-pulse"></div>
        <div class="relative bg-gradient-to-br from-emamut-orange to-emamut-orange-dark rounded-2xl p-6 sm:p-8 shadow-2xl">
          <div class="bg-white dark:bg-gray-800 rounded-xl p-6 space-y-4 shadow-inner transition-colors duration-200">
            <!-- Window header -->
            <div class="flex items-center justify-between border-b border-gray-100 dark:border-gray-700 pb-3">
              <div class="flex items-center space-x-2">
                <div class="w-3 h-3 bg-red-500 rounded-full"></div>
                <div class="w-3 h-3 bg-yellow-500 rounded-full"></div>
                <div class="w-3 h-3 bg-green-500 rounded-full"></div>
              </div>
              <span class="text-xs font-mono text-gray-400 dark:text-gray-500">emamut-suite.tsx</span>
            </div>

            <!-- Code lines animation representation -->
            <div class="space-y-3 pt-2">
              <div class="h-4 bg-gray-200 dark:bg-gray-700 rounded w-3/4"></div>
              <div class="h-4 bg-emamut-orange rounded w-1/2"></div>
              <div class="h-4 bg-gray-200 dark:bg-gray-700 rounded w-5/6"></div>
              <div class="h-4 bg-gray-200 dark:bg-gray-700 rounded w-2/3"></div>
              <div class="h-4 bg-emamut-orange/60 rounded w-4/5"></div>
            </div>

            <!-- Mini interactive status bar -->
            <div class="pt-4 flex items-center justify-between text-xs text-gray-500 dark:text-gray-400 border-t border-gray-100 dark:border-gray-700">
              <span class="flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                Servidor activo
              </span>
              <span class="font-mono text-[11px] text-emamut-orange font-medium">99.9% Uptime</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
