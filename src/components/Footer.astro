---
import { Github, Linkedin, Twitter, Mail, Phone, MessageCircle } from '@lucide/astro';
---

<footer class="bg-gray-50 dark:bg-gray-950 text-gray-600 dark:text-gray-300 pt-16 pb-12 border-t border-gray-200 dark:border-gray-800 transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 mb-12">
      <!-- Columna 1: Branding -->
      <div class="space-y-4">
        <a href="/#hero" class="inline-block focus:outline-none" aria-label="Inicio Emamut">
          <img
            src="/logo-emamut.png"
            alt="Emamut Logo"
            class="h-12 w-auto dark:brightness-0 dark:invert transition-all"
          />
        </a>
        <p class="text-sm text-gray-600 dark:text-gray-400 leading-relaxed">
          Transformamos ideas en soluciones tecnológicas innovadoras. Desarrollamos software a medida, aplicaciones web y móviles para impulsar tu negocio.
        </p>
        <div class="flex items-center space-x-3 pt-2">
          <a
            href="https://github.com/orgs/emamut-dev/"
            target="_blank"
            rel="noopener noreferrer"
            class="w-9 h-9 rounded-lg bg-gray-200/80 dark:bg-gray-900 flex items-center justify-center text-gray-600 dark:text-gray-400 hover:text-white hover:bg-emamut-orange dark:hover:text-white dark:hover:bg-emamut-orange transition-colors"
            aria-label="GitHub de Emamut"
          >
            <Github class="w-4 h-4" />
          </a>
          <a
            href="https://www.linkedin.com/company/emamut/"
            target="_blank"
            rel="noopener noreferrer"
            class="w-9 h-9 rounded-lg bg-gray-200/80 dark:bg-gray-900 flex items-center justify-center text-gray-600 dark:text-gray-400 hover:text-white hover:bg-emamut-orange dark:hover:text-white dark:hover:bg-emamut-orange transition-colors"
            aria-label="LinkedIn de Emamut"
          >
            <Linkedin class="w-4 h-4" />
          </a>
          <a
            href="https://x.com/emamutDev"
            target="_blank"
            rel="noopener noreferrer"
            class="w-9 h-9 rounded-lg bg-gray-200/80 dark:bg-gray-900 flex items-center justify-center text-gray-600 dark:text-gray-400 hover:text-white hover:bg-emamut-orange dark:hover:text-white dark:hover:bg-emamut-orange transition-colors"
            aria-label="X / Twitter de Emamut"
          >
            <Twitter class="w-4 h-4" />
          </a>
          <a
            href="https://wa.me/573023122904/?text=¡Hola!%20Necesito%20más%20información"
            target="_blank"
            rel="noopener noreferrer"
            class="w-9 h-9 rounded-lg bg-gray-200/80 dark:bg-gray-900 flex items-center justify-center text-gray-600 dark:text-gray-400 hover:text-white hover:bg-emamut-orange dark:hover:text-white dark:hover:bg-emamut-orange transition-colors"
            aria-label="WhatsApp de Emamut"
          >
            <MessageCircle class="w-4 h-4" />
          </a>
        </div>
      </div>

      <!-- Columna 2: Servicios -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-gray-900 dark:text-white mb-4">Servicios</h3>
        <ul class="space-y-2.5 text-sm text-gray-600 dark:text-gray-400">
          <li>
            <a href="/#portfolio" class="hover:text-emamut-orange transition-colors">
              Desarrollo Web
            </a>
          </li>
          <li>
            <a href="/#portfolio" class="hover:text-emamut-orange transition-colors">
              Apps Móviles
            </a>
          </li>
          <li>
            <a href="/#portfolio" class="hover:text-emamut-orange transition-colors">
              E-Commerce
            </a>
          </li>
          <li>
            <a href="/#portfolio" class="hover:text-emamut-orange transition-colors">
              Consultoría IT & Cloud
            </a>
          </li>
        </ul>
      </div>

      <!-- Columna 3: Empresa -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-gray-900 dark:text-white mb-4">Empresa</h3>
        <ul class="space-y-2.5 text-sm text-gray-600 dark:text-gray-400">
          <li>
            <a href="/#hero" class="hover:text-emamut-orange transition-colors">
              Sobre Nosotros
            </a>
          </li>
          <li>
            <a href="/#portfolio" class="hover:text-emamut-orange transition-colors">
              Portfolio
            </a>
          </li>
          <li>
            <a href="/blog" class="hover:text-emamut-orange transition-colors">
              Blog Técnico
            </a>
          </li>
          <li>
            <a href="/#contact" class="hover:text-emamut-orange transition-colors">
              Contacto
            </a>
          </li>
        </ul>
      </div>

      <!-- Columna 4: Contacto directo -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-gray-900 dark:text-white mb-4">Contacto</h3>
        <ul class="space-y-2.5 text-sm text-gray-600 dark:text-gray-400">
          <li class="flex items-center space-x-2">
            <Mail class="w-4 h-4 text-emamut-orange shrink-0" />
            <a href="mailto:contacto@emamut.com" class="hover:text-emamut-orange transition-colors">
              contacto@emamut.com
            </a>
          </li>
          <li class="flex items-center space-x-2">
            <Phone class="w-4 h-4 text-emamut-orange shrink-0" />
            <a href="tel:+573023122904" class="hover:text-emamut-orange transition-colors">
              +57 302 312 2904
            </a>
          </li>
          <li class="pt-2">
            <a
              href="https://wa.me/573023122904/?text=¡Hola!%20Quisiera%20agendar%20una%20consulta"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center space-x-2 px-4 py-2 text-xs font-semibold rounded-lg bg-emamut-orange text-white hover:bg-emamut-orange-dark transition-colors"
            >
              <MessageCircle class="w-3.5 h-3.5" />
              <span>Chatear por WhatsApp</span>
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Barra inferior -->
    <div class="border-t border-gray-200 dark:border-gray-800/80 pt-8 flex flex-col sm:flex-row items-center justify-between text-xs text-gray-500 dark:text-gray-400 gap-4">
      <p>&copy; {new Date().getFullYear()} Emamut. Todos los derechos reservados.</p>
      <p class="flex items-center gap-1">
        Construido con tecnología moderna para emprendedores.
      </p>
    </div>
  </div>
</footer>