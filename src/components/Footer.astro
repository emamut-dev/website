---
import { Icon } from "astro-icon/components";
---

<footer
  class="bg-pumice dark:bg-obsidian text-obsidian dark:text-limestone pt-16 pb-12 transition-colors relative border-t-[1.5px] border-dotted border-obsidian/30 dark:border-white/20"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
    <!-- Top Branding & Grid -->
    <div
      class="grid grid-cols-2 gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-12 lg:gap-10"
    >
      <!-- Columna 1: Branding (5 cols) -->
      <div
        class="col-span-2 sm:col-span-2 lg:col-span-5 space-y-5"
        data-animate="fade-up"
      >
        <a
          href="/#hero"
          class="inline-block focus:outline-none"
          aria-label="Inicio Emamut"
        >
          <img
            src="/logo-emamut.png"
            alt="Emamut Logo"
            class="h-10 sm:h-12 w-auto dark:brightness-0 dark:invert transition-all"
            loading="lazy"
            decoding="async"
          />
        </a>
        <p class="text-sm text-obsidian/75 dark:text-limestone/75 leading-relaxed max-w-sm font-medium">
          Transformamos ideas complejas en soluciones tecnológicas innovadoras.
          Desarrollamos software a medida, aplicaciones web y móviles de alto
          rendimiento con arquitectura moderna.
        </p>

        <!-- Social Pills -->
        <div class="flex items-center space-x-2.5 pt-1">
          <a
            href="https://github.com/orgs/emamut-dev/"
            target="_blank"
            rel="noopener noreferrer"
            class="w-10 h-10 rounded-full bg-limestone dark:bg-white/10 flex items-center justify-center text-obsidian dark:text-chalk hover:bg-ember hover:text-obsidian transition-colors"
            aria-label="GitHub de Emamut"
          >
            <Icon name="simple-icons:github" class="w-4 h-4" />
          </a>
          <a
            href="https://www.linkedin.com/company/emamut/"
            target="_blank"
            rel="noopener noreferrer"
            class="w-10 h-10 rounded-full bg-limestone dark:bg-white/10 flex items-center justify-center text-obsidian dark:text-chalk hover:bg-ember hover:text-obsidian transition-colors"
            aria-label="LinkedIn de Emamut"
          >
            <Icon name="simple-icons:linkedin" class="w-4 h-4" />
          </a>
          <a
            href="https://x.com/emamutDev"
            target="_blank"
            rel="noopener noreferrer"
            class="w-10 h-10 rounded-full bg-limestone dark:bg-white/10 flex items-center justify-center text-obsidian dark:text-chalk hover:bg-ember hover:text-obsidian transition-colors"
            aria-label="X / Twitter de Emamut"
          >
            <Icon name="simple-icons:x" class="w-4 h-4" />
          </a>
          <a
            href="https://wa.me/573023122904/?text=¡Hola!%20Necesito%20más%20información"
            target="_blank"
            rel="noopener noreferrer"
            class="w-10 h-10 rounded-full bg-limestone dark:bg-white/10 flex items-center justify-center text-obsidian dark:text-chalk hover:bg-ember hover:text-obsidian transition-colors"
            aria-label="WhatsApp de Emamut"
          >
            <Icon name="simple-icons:whatsapp" class="w-4 h-4" />
          </a>
        </div>
      </div>

      <!-- Columna 2: Servicios (2 cols) -->
      <div
        class="col-span-1 lg:col-span-2 space-y-4"
        data-animate="fade-up"
        data-animate-delay="50"
      >
        <h3 class="text-xs font-semibold uppercase tracking-widest text-obsidian dark:text-chalk">
          Servicios
        </h3>
        <ul class="space-y-3 text-sm font-medium text-obsidian/75 dark:text-limestone/75">
          <li>
            <a href="/#portfolio" class="hover:text-ember transition-colors">
              Desarrollo Web
            </a>
          </li>
          <li>
            <a href="/#portfolio" class="hover:text-ember transition-colors">
              Apps Móviles
            </a>
          </li>
          <li>
            <a href="/#portfolio" class="hover:text-ember transition-colors">
              E-Commerce
            </a>
          </li>
          <li>
            <a href="/#portfolio" class="hover:text-ember transition-colors">
              Cloud & DevOps
            </a>
          </li>
        </ul>
      </div>

      <!-- Columna 3: Empresa (2 cols) -->
      <div
        class="col-span-1 lg:col-span-2 space-y-4"
        data-animate="fade-up"
        data-animate-delay="100"
      >
        <h3 class="text-xs font-semibold uppercase tracking-widest text-obsidian dark:text-chalk">
          Empresa
        </h3>
        <ul class="space-y-3 text-sm font-medium text-obsidian/75 dark:text-limestone/75">
          <li>
            <a href="/#hero" class="hover:text-ember transition-colors">
              Inicio
            </a>
          </li>
          <li>
            <a href="/#portfolio" class="hover:text-ember transition-colors">
              Portfolio
            </a>
          </li>
          <li>
            <a href="/blog" class="hover:text-ember transition-colors">
              Blog Técnico
            </a>
          </li>
          <li>
            <a href="/#contact" class="hover:text-ember transition-colors">
              Contacto
            </a>
          </li>
        </ul>
      </div>

      <!-- Columna 4: Contacto directo (3 cols) -->
      <div
        class="col-span-2 sm:col-span-2 lg:col-span-3 space-y-4"
        data-animate="fade-up"
        data-animate-delay="150"
      >
        <h3 class="text-xs font-semibold uppercase tracking-widest text-obsidian dark:text-chalk">
          Contacto Directo
        </h3>
        <ul class="space-y-3 text-sm font-medium text-obsidian/75 dark:text-limestone/75">
          <li class="flex items-center space-x-2.5">
            <Icon name="lucide:mail" class="w-4 h-4 text-ember shrink-0" />
            <a href="mailto:contacto@emamut.com" class="hover:text-ember transition-colors">
              contacto@emamut.com
            </a>
          </li>
          <li class="flex items-center space-x-2.5">
            <Icon name="lucide:phone" class="w-4 h-4 text-ember shrink-0" />
            <a href="tel:+573023122904" class="hover:text-ember transition-colors">
              +57 302 312 2904
            </a>
          </li>
          <li class="flex items-center space-x-2.5">
            <Icon name="lucide:map-pin" class="w-4 h-4 text-ember shrink-0" />
            <span>Bogotá, Colombia</span>
          </li>
          <li class="pt-2">
            <a
              href="https://wa.me/573023122904/?text=¡Hola!%20Quisiera%20agendar%20una%20consulta"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center space-x-2 px-5 py-2.5 rounded-full text-xs font-medium bg-ember hover:bg-ember-dark text-obsidian transition-transform hover:scale-105"
            >
              <Icon name="simple-icons:whatsapp" class="w-3.5 h-3.5" />
              <span>Chatear por WhatsApp</span>
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Barra inferior con Dotted Divider -->
    <div
      class="border-t border-dotted border-obsidian/20 dark:border-white/20 pt-8 flex flex-col sm:flex-row items-center justify-between text-xs text-obsidian/60 dark:text-limestone/60 gap-4 font-medium"
    >
      <p>
        &copy; {new Date().getFullYear()} Emamut. Todos los derechos reservados.
      </p>
      <p class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-ember"></span>
        Caldera Design System &middot; Hecho para escalar
      </p>
    </div>
  </div>
</footer>
