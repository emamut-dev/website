---
import { Icon } from 'astro-icon/components';

interface SocialLink {
  icon: string;
  url: string;
}

interface Props {
  socialNetworks?: SocialLink[];
}

const { socialNetworks = [] } = Astro.props;

// Mapeo flexible para iconos de redes sociales (soporta nombres directos de FontAwesome, Simple Icons, etc.)
const resolveSocialIcon = (iconName: string): string => {
  const cleanName = (iconName || '')
    .toLowerCase()
    .trim()
    .replace(/^fa-(brands|solid|regular)\s+/, '')
    .replace(/^fa-/, '');

  const iconMap: Record<string, string> = {
    github: 'simple-icons:github',
    linkedin: 'simple-icons:linkedin',
    twitter: 'simple-icons:x',
    'x-twitter': 'simple-icons:x',
    x: 'simple-icons:x',
    whatsapp: 'simple-icons:whatsapp',
    instagram: 'simple-icons:instagram',
    facebook: 'simple-icons:facebook',
    youtube: 'simple-icons:youtube',
    discord: 'simple-icons:discord',
    telegram: 'simple-icons:telegram',
    tiktok: 'simple-icons:tiktok',
    mail: 'lucide:mail',
    envelope: 'lucide:mail',
    phone: 'lucide:phone',
  };

  return iconMap[cleanName] || (cleanName.includes(':') ? cleanName : `simple-icons:${cleanName}`);
};

const defaultSocialLinks: SocialLink[] = [
  { icon: 'github', url: 'https://github.com/orgs/emamut-dev/' },
  { icon: 'linkedin', url: 'https://www.linkedin.com/company/emamut/' },
  { icon: 'x', url: 'https://x.com/emamutDev' },
  { icon: 'whatsapp', url: 'https://wa.me/573160414585/?text=¡Hola!%20Necesito%20más%20información' },
];

const socialLinks = socialNetworks.length > 0 ? socialNetworks : defaultSocialLinks;
---

<section id="contact" class="py-20 bg-white dark:bg-gray-900 transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emamut-orange/10 text-emamut-orange text-xs font-semibold tracking-wider uppercase mb-3">
        Contacto Directo
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-gray-900 dark:text-white tracking-tight">
        Contacta con Nosotros
      </h2>
      <p class="mt-4 text-lg text-gray-600 dark:text-gray-300 leading-relaxed">
        ¿Tienes un proyecto en mente? Nos encantaría escuchar tus ideas y ayudarte a convertirlas en realidad.
      </p>
    </div>

    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-start">
      <!-- Formulario Netlify -->
      <div class="bg-white dark:bg-gray-800 rounded-2xl p-6 sm:p-8 shadow-xl border border-gray-100 dark:border-gray-700/80 transition-colors">
        <div class="mb-6">
          <h3 class="text-2xl font-bold text-gray-900 dark:text-white">Envíanos un Mensaje</h3>
          <p class="text-sm text-gray-600 dark:text-gray-300 mt-1">
            Completa el formulario y te responderemos en menos de 24 horas.
          </p>
        </div>

        <form
          name="contact"
          method="POST"
          data-netlify="true"
          class="space-y-4"
        >
          <input type="hidden" name="form-name" value="contact" />

          <div class="grid sm:grid-cols-2 gap-4">
            <div class="space-y-1.5">
              <label for="name" class="text-xs font-semibold text-gray-700 dark:text-gray-300">
                Nombre completo <span class="text-emamut-orange">*</span>
              </label>
              <input
                type="text"
                id="name"
                name="name"
                required
                placeholder="Tu nombre"
                class="w-full px-4 py-2.5 rounded-xl border border-gray-200 dark:border-gray-700 bg-gray-50/50 dark:bg-gray-900/50 text-gray-900 dark:text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-emamut-orange focus:border-transparent transition-all"
              />
            </div>
            <div class="space-y-1.5">
              <label for="email" class="text-xs font-semibold text-gray-700 dark:text-gray-300">
                Correo electrónico <span class="text-emamut-orange">*</span>
              </label>
              <input
                type="email"
                id="email"
                name="email"
                required
                placeholder="tu@email.com"
                class="w-full px-4 py-2.5 rounded-xl border border-gray-200 dark:border-gray-700 bg-gray-50/50 dark:bg-gray-900/50 text-gray-900 dark:text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-emamut-orange focus:border-transparent transition-all"
              />
            </div>
          </div>

          <div class="space-y-1.5">
            <label for="company" class="text-xs font-semibold text-gray-700 dark:text-gray-300">
              Empresa <span class="text-gray-400 font-normal">(opcional)</span>
            </label>
            <input
              type="text"
              id="company"
              name="company"
              placeholder="Nombre de tu empresa o proyecto"
              class="w-full px-4 py-2.5 rounded-xl border border-gray-200 dark:border-gray-700 bg-gray-50/50 dark:bg-gray-900/50 text-gray-900 dark:text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-emamut-orange focus:border-transparent transition-all"
            />
          </div>

          <div class="space-y-1.5">
            <label for="subject" class="text-xs font-semibold text-gray-700 dark:text-gray-300">
              Asunto <span class="text-emamut-orange">*</span>
            </label>
            <input
              type="text"
              id="subject"
              name="subject"
              required
              placeholder="¿En qué podemos ayudarte?"
              class="w-full px-4 py-2.5 rounded-xl border border-gray-200 dark:border-gray-700 bg-gray-50/50 dark:bg-gray-900/50 text-gray-900 dark:text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-emamut-orange focus:border-transparent transition-all"
            />
          </div>

          <div class="space-y-1.5">
            <label for="message" class="text-xs font-semibold text-gray-700 dark:text-gray-300">
              Mensaje <span class="text-emamut-orange">*</span>
            </label>
            <textarea
              id="message"
              name="message"
              rows="4"
              required
              placeholder="Cuéntanos más sobre tus necesidades, objetivos o presupuesto..."
              class="w-full px-4 py-2.5 rounded-xl border border-gray-200 dark:border-gray-700 bg-gray-50/50 dark:bg-gray-900/50 text-gray-900 dark:text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-emamut-orange focus:border-transparent transition-all resize-none"
            ></textarea>
          </div>

          <button
            type="submit"
            class="w-full py-3.5 px-6 rounded-xl font-semibold text-sm bg-emamut-orange hover:bg-emamut-orange-dark text-white shadow-lg shadow-orange-500/25 hover:shadow-orange-500/35 transition-all duration-200 flex items-center justify-center gap-2 cursor-pointer"
          >
            <Icon name="lucide:send" class="w-4 h-4" />
            <span>Enviar Mensaje</span>
          </button>
        </form>
      </div>

      <!-- Información de Contacto y Redes -->
      <div class="space-y-8">
        <div>
          <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-6">
            Información de Contacto
          </h3>
          <div class="space-y-5">
            <!-- Email -->
            <div class="flex items-start space-x-4">
              <div class="p-3 rounded-xl bg-emamut-orange/10 dark:bg-emamut-orange/20 text-emamut-orange shrink-0">
                <Icon name="lucide:mail" class="w-6 h-6" />
              </div>
              <div>
                <h4 class="font-semibold text-gray-900 dark:text-white text-sm">Correo Electrónico</h4>
                <a href="mailto:emamut@outlook.com" class="text-sm text-gray-600 dark:text-gray-300 hover:text-emamut-orange block transition-colors">
                  emamut@outlook.com
                </a>
              </div>
            </div>

            <!-- Teléfono / WhatsApp -->
            <div class="flex items-start space-x-4">
              <div class="p-3 rounded-xl bg-emamut-orange/10 dark:bg-emamut-orange/20 text-emamut-orange shrink-0">
                <Icon name="lucide:phone" class="w-6 h-6" />
              </div>
              <div>
                <h4 class="font-semibold text-gray-900 dark:text-white text-sm">Teléfono & WhatsApp</h4>
                <a href="https://wa.me/573160414585" target="_blank" rel="noopener noreferrer" class="text-sm text-gray-600 dark:text-gray-300 hover:text-emamut-orange block transition-colors">
                  +57 316 041 4585
                </a>
                <span class="text-xs text-gray-400">Atención de Lunes a Viernes (9:00 - 18:00)</span>
              </div>
            </div>

            <!-- Ubicación -->
            <div class="flex items-start space-x-4">
              <div class="p-3 rounded-xl bg-emamut-orange/10 dark:bg-emamut-orange/20 text-emamut-orange shrink-0">
                <Icon name="lucide:map-pin" class="w-6 h-6" />
              </div>
              <div>
                <h4 class="font-semibold text-gray-900 dark:text-white text-sm">Ubicación</h4>
                <p class="text-sm text-gray-600 dark:text-gray-300">
                  Bogotá, Colombia
                </p>
                <span class="text-xs text-gray-400">Servicios remotos para todo el mundo</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Redes Sociales -->
        <div>
          <h4 class="text-sm font-semibold uppercase tracking-wider text-gray-700 dark:text-gray-300 mb-3">
            Síguenos en Redes
          </h4>
          <div class="flex flex-wrap gap-3">
            {socialLinks.map((social) => (
              <a
                href={social.url}
                target="_blank"
                rel="noopener noreferrer"
                class="p-3 rounded-xl bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 hover:bg-emamut-orange hover:text-white dark:hover:bg-emamut-orange dark:hover:text-white transition-all shadow-sm"
                aria-label={`Red social ${social.icon}`}
              >
                <Icon name={resolveSocialIcon(social.icon)} class="w-5 h-5" />
              </a>
            ))}
          </div>
        </div>

        <!-- Banner de Consulta Gratuita -->
        <div class="bg-gradient-to-br from-emamut-orange to-emamut-orange-dark rounded-2xl p-6 sm:p-8 text-white shadow-xl relative overflow-hidden">
          <div class="relative z-10 space-y-3">
            <h4 class="text-xl font-bold">¿Listo para empezar tu próximo proyecto?</h4>
            <p class="text-sm opacity-90 leading-relaxed">
              Agenda una consulta gratuita de 30 minutos y descubre cómo podemos potenciar tu negocio digital.
            </p>
            <div class="pt-2">
              <a
                href="https://wa.me/573160414585/?text=¡Hola!%20Quisiera%20agendar%20una%20consulta%20gratuita"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 px-6 py-2.5 rounded-xl font-semibold text-sm bg-white text-emamut-orange hover:bg-gray-50 shadow-md transition-colors"
              >
                <Icon name="simple-icons:whatsapp" class="w-4 h-4" />
                <span>Agendar Consulta</span>
              </a>
            </div>
          </div>
          <!-- Fondo decorativo -->
          <div class="absolute -right-8 -bottom-8 w-32 h-32 bg-white/10 rounded-full blur-xl pointer-events-none"></div>
        </div>
      </div>
    </div>
  </div>
</section>
