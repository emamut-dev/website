---
import { Icon } from "astro-icon/components";

interface SocialLink {
  icon: string;
  url: string;
}

interface Props {
  socialNetworks?: SocialLink[];
}

const { socialNetworks = [] } = Astro.props;

// Mapeo flexible para iconos de redes sociales (soporta nombres directos de FontAwesome, Simple Icons, etc.)
const resolveSocialIcon = (iconName: string): string => {
  const cleanName = (iconName || "")
    .toLowerCase()
    .trim()
    .replace(/^fa-(brands|solid|regular)\s+/, "")
    .replace(/^fa-/, "");

  const iconMap: Record<string, string> = {
    github: "simple-icons:github",
    linkedin: "simple-icons:linkedin",
    twitter: "simple-icons:x",
    "x-twitter": "simple-icons:x",
    x: "simple-icons:x",
    whatsapp: "simple-icons:whatsapp",
    instagram: "simple-icons:instagram",
    facebook: "simple-icons:facebook",
    youtube: "simple-icons:youtube",
    discord: "simple-icons:discord",
    telegram: "simple-icons:telegram",
    tiktok: "simple-icons:tiktok",
    mail: "lucide:mail",
    envelope: "lucide:mail",
    phone: "lucide:phone",
  };

  return (
    iconMap[cleanName] ||
    (cleanName.includes(":") ? cleanName : `simple-icons:${cleanName}`)
  );
};

const defaultSocialLinks: SocialLink[] = [
  { icon: "github", url: "https://github.com/orgs/emamut-dev/" },
  { icon: "linkedin", url: "https://www.linkedin.com/company/emamut/" },
  { icon: "x", url: "https://x.com/emamutDev" },
  {
    icon: "whatsapp",
    url: "https://wa.me/573160414585/?text=¡Hola!%20Necesito%20más%20información",
  },
];

const socialLinks =
  socialNetworks.length > 0 ? socialNetworks : defaultSocialLinks;
---

<section id="contact" class="py-20 bg-pumice dark:bg-obsidian transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto space-y-4" data-animate="fade-up">
      <div
        class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-sulfur text-obsidian text-xs font-semibold tracking-wider uppercase"
      >
        Contacto Directo &middot; Conversemos
      </div>
      <h2
        class="display-title text-4xl sm:text-6xl lg:text-7xl uppercase text-obsidian dark:text-chalk"
      >
        Contacta con Nosotros
      </h2>
      <p class="text-base sm:text-lg text-obsidian/80 dark:text-limestone/80 leading-relaxed font-medium">
        ¿Tienes un proyecto en mente o necesitas escalar tu infraestructura? Cuéntanos
        tus objetivos y diseñaremos la mejor solución tecnológica.
      </p>
    </div>

    <!-- Caldera Signature Dark Input Section (Obsidian card, 40px radius) -->
    <div
      class="bg-obsidian rounded-[40px] p-8 sm:p-12 lg:p-16 text-chalk border border-chalk/10"
      data-animate="fade-up"
      data-animate-delay="100"
    >
      <div class="grid lg:grid-cols-12 gap-12 lg:gap-16 items-start">
        <!-- Formulario Netlify (7 cols) -->
        <div class="lg:col-span-7 space-y-8">
          <div>
            <span class="text-xs font-mono uppercase text-sulfur tracking-widest block mb-2">
              FORMULARIO DE CONTACTO
            </span>
            <h3 class="display-title text-3xl sm:text-4xl uppercase text-chalk">
              Envíanos un Mensaje
            </h3>
            <p class="text-sm text-chalk/70 mt-1 font-medium">
              Completa el formulario y responderemos en menos de 24 horas hábiles.
            </p>
          </div>

          <form
            name="contact"
            method="POST"
            data-netlify="true"
            class="space-y-5"
          >
            <input type="hidden" name="form-name" value="contact" />

            <div class="grid sm:grid-cols-2 gap-5">
              <div class="space-y-2">
                <label
                  for="name"
                  class="text-xs font-medium text-chalk/80 tracking-wider uppercase"
                >
                  Nombre completo <span class="text-ember">*</span>
                </label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  placeholder="Tu nombre"
                  class="w-full px-6 py-3.5 rounded-full border-[1.5px] border-chalk/30 bg-transparent text-chalk placeholder:text-chalk/35 focus:outline-none focus:border-ember focus:ring-1 focus:ring-ember transition-all text-sm font-medium"
                />
              </div>
              <div class="space-y-2">
                <label
                  for="email"
                  class="text-xs font-medium text-chalk/80 tracking-wider uppercase"
                >
                  Correo electrónico <span class="text-ember">*</span>
                </label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  placeholder="tu@email.com"
                  class="w-full px-6 py-3.5 rounded-full border-[1.5px] border-chalk/30 bg-transparent text-chalk placeholder:text-chalk/35 focus:outline-none focus:border-ember focus:ring-1 focus:ring-ember transition-all text-sm font-medium"
                />
              </div>
            </div>

            <div class="grid sm:grid-cols-2 gap-5">
              <div class="space-y-2">
                <label
                  for="company"
                  class="text-xs font-medium text-chalk/80 tracking-wider uppercase"
                >
                  Empresa o Proyecto
                </label>
                <input
                  type="text"
                  id="company"
                  name="company"
                  placeholder="Nombre de tu empresa"
                  class="w-full px-6 py-3.5 rounded-full border-[1.5px] border-chalk/30 bg-transparent text-chalk placeholder:text-chalk/35 focus:outline-none focus:border-ember focus:ring-1 focus:ring-ember transition-all text-sm font-medium"
                />
              </div>
              <div class="space-y-2">
                <label
                  for="subject"
                  class="text-xs font-medium text-chalk/80 tracking-wider uppercase"
                >
                  Asunto <span class="text-ember">*</span>
                </label>
                <input
                  type="text"
                  id="subject"
                  name="subject"
                  required
                  placeholder="Desarrollo Web / App / Consultoría"
                  class="w-full px-6 py-3.5 rounded-full border-[1.5px] border-chalk/30 bg-transparent text-chalk placeholder:text-chalk/35 focus:outline-none focus:border-ember focus:ring-1 focus:ring-ember transition-all text-sm font-medium"
                />
              </div>
            </div>

            <div class="space-y-2">
              <label
                for="message"
                class="text-xs font-medium text-chalk/80 tracking-wider uppercase"
              >
                Mensaje <span class="text-ember">*</span>
              </label>
              <textarea
                id="message"
                name="message"
                rows="4"
                required
                placeholder="Cuéntanos más sobre tus necesidades, objetivos o presupuesto..."
                class="w-full px-6 py-4 rounded-[28px] border-[1.5px] border-chalk/30 bg-transparent text-chalk placeholder:text-chalk/35 focus:outline-none focus:border-ember focus:ring-1 focus:ring-ember transition-all text-sm font-medium resize-none"
              ></textarea>
            </div>

            <button
              type="submit"
              class="w-full py-4 px-8 rounded-full font-medium text-base bg-ember hover:bg-ember-dark text-obsidian transition-transform hover:scale-[1.01] active:scale-100 flex items-center justify-center gap-2 cursor-pointer"
            >
              <span>Enviar Mensaje</span>
              <Icon name="lucide:send" class="w-4 h-4" />
            </button>
          </form>
        </div>

        <!-- Canales Directos y Redes (5 cols) -->
        <div class="lg:col-span-5 space-y-8 lg:border-l lg:border-dotted lg:border-chalk/20 lg:pl-12">
          <div>
            <span class="text-xs font-mono uppercase text-sulfur tracking-widest block mb-2">
              CANALES DIRECTOS
            </span>
            <h3 class="display-title text-3xl uppercase text-chalk mb-6">
              Información de Contacto
            </h3>

            <div class="space-y-6">
              <!-- Email -->
              <div class="flex items-start space-x-4">
                <div class="p-3 rounded-full bg-chalk/10 text-ember shrink-0">
                  <Icon name="lucide:mail" class="w-5 h-5" />
                </div>
                <div>
                  <h4 class="text-xs uppercase tracking-wider text-chalk/60 font-medium">
                    Correo Electrónico
                  </h4>
                  <a
                    href="mailto:emamut@outlook.com"
                    class="text-base text-chalk hover:text-ember block transition-colors font-medium mt-0.5"
                  >
                    emamut@outlook.com
                  </a>
                </div>
              </div>

              <!-- Teléfono / WhatsApp -->
              <div class="flex items-start space-x-4">
                <div class="p-3 rounded-full bg-chalk/10 text-ember shrink-0">
                  <Icon name="lucide:phone" class="w-5 h-5" />
                </div>
                <div>
                  <h4 class="text-xs uppercase tracking-wider text-chalk/60 font-medium">
                    Teléfono & WhatsApp
                  </h4>
                  <a
                    href="https://wa.me/573160414585"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-base text-chalk hover:text-ember block transition-colors font-medium mt-0.5"
                  >
                    +57 316 041 4585
                  </a>
                  <span class="text-xs text-chalk/50 font-mono block mt-0.5">
                    Lunes a Viernes &middot; 9:00 a 18:00
                  </span>
                </div>
              </div>

              <!-- Ubicación -->
              <div class="flex items-start space-x-4">
                <div class="p-3 rounded-full bg-chalk/10 text-ember shrink-0">
                  <Icon name="lucide:map-pin" class="w-5 h-5" />
                </div>
                <div>
                  <h4 class="text-xs uppercase tracking-wider text-chalk/60 font-medium">
                    Ubicación
                  </h4>
                  <p class="text-base text-chalk font-medium mt-0.5">
                    Bogotá, Colombia
                  </p>
                  <span class="text-xs text-chalk/50 font-mono block mt-0.5">
                    Operación global remota
                  </span>
                </div>
              </div>
            </div>
          </div>

          <!-- Redes Sociales (Pills) -->
          <div class="pt-2">
            <h4 class="text-xs font-semibold uppercase tracking-wider text-chalk/70 mb-3">
              Conéctate con Nosotros
            </h4>
            <div class="flex flex-wrap gap-3">
              {
                socialLinks.map((social) => (
                  <a
                    href={social.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="w-11 h-11 rounded-full bg-chalk/10 text-chalk hover:bg-ember hover:text-obsidian flex items-center justify-center transition-colors"
                    aria-label={`Red social ${social.icon}`}
                  >
                    <Icon name={resolveSocialIcon(social.icon)} class="w-4 h-4" />
                  </a>
                ))
              }
            </div>
          </div>

          <!-- Banner WhatsApp Consulta Gratuita (Limestone surface card) -->
          <div
            class="bg-limestone text-obsidian rounded-[32px] p-6 sm:p-8 space-y-4"
          >
            <span class="inline-flex items-center px-3 py-1 rounded-full bg-sulfur text-obsidian text-xs font-medium uppercase">
              Asesoría Sin Costo
            </span>
            <h4 class="display-title text-2xl uppercase leading-none">
              ¿Listo para dar el siguiente paso?
            </h4>
            <p class="text-sm text-obsidian/80 leading-relaxed font-medium">
              Agenda una sesión de 30 minutos y evaluemos la arquitectura ideal para tu proyecto.
            </p>
            <div class="pt-1">
              <a
                href="https://wa.me/573160414585/?text=¡Hola!%20Quisiera%20agendar%20una%20consulta%20gratuita"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 px-6 py-2.5 rounded-full font-medium text-xs bg-ember hover:bg-ember-dark text-obsidian transition-transform hover:scale-105"
              >
                <Icon name="simple-icons:whatsapp" class="w-4 h-4" />
                <span>Chatear por WhatsApp</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
