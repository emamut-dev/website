---
import { Icon } from "astro-icon/components";

interface DatoThumbnail {
  responsiveImage?: {
    src?: string;
    srcSet?: string;
    width?: number;
    height?: number;
    alt?: string;
  };
}

interface BlogPost {
  title: string;
  slug: string;
  content?: string;
  thumbnail?: DatoThumbnail;
  excerpt?: string;
  author?: string;
  date?: string;
  readTime?: string;
  category?: string;
  tags?: string[] | string;
  image?: string;
}

interface Props {
  posts?: BlogPost[];
}

const { posts = [] } = Astro.props;

// Parser para procesar el campo tags de DatoCMS
const parseTags = (tags?: string[] | string): string[] => {
  if (!tags) return [];
  if (Array.isArray(tags)) return tags.map((t) => String(t).trim()).filter(Boolean);
  if (typeof tags === "string") {
    return tags
      .split(/[,;\n]+/)
      .map((t) => t.trim())
      .filter((t) => t.length > 0);
  }
  return [];
};

// Mapeo exclusivo de artículos reales de DatoCMS
const realPosts = posts.map((post) => {
  const plainText = post.content
    ? post.content.replace(/[#*`_\[\]]/g, "").slice(0, 140) + "..."
    : "";
  const imgUrl = post.thumbnail?.responsiveImage?.src || "/placeholder.svg";
  const parsedTags = parseTags(post.tags);

  return {
    ...post,
    excerpt:
      post.excerpt ||
      plainText ||
      "Aprende los conceptos fundamentales para potenciar y blindar tu proyecto digital.",
    author: post.author || "Equipo Emamut",
    date: post.date || "Reciente",
    readTime: post.readTime || "4 min",
    category: parsedTags.length > 0 ? parsedTags[0] : (post.category || "Tecnología"),
    tags: parsedTags,
    image: imgUrl,
  };
});
---

<section
  id="blog"
  class="py-20 bg-gray-50 dark:bg-gray-800/50 transition-colors"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-16" data-animate="fade-up">
      <div
        class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emamut-orange/10 text-emamut-orange text-xs font-semibold tracking-wider uppercase mb-3"
      >
        Artículos & Recursos
      </div>
      <h2
        class="text-3xl sm:text-4xl lg:text-5xl font-bold text-gray-900 dark:text-white tracking-tight"
      >
        Blog Técnico
      </h2>
      <p class="mt-4 text-lg text-gray-600 dark:text-gray-300 leading-relaxed">
        Mantente al día con las últimas tendencias tecnológicas, tutoriales y
        conocimientos de nuestro equipo de desarrollo.
      </p>
    </div>

    <!-- Grid -->
    {
      realPosts.length > 0 ? (
        <div
          class:list={[
            "grid gap-8",
            realPosts.length === 1
              ? "grid-cols-1 max-w-md mx-auto"
              : realPosts.length === 2
                ? "grid-cols-1 md:grid-cols-2 max-w-4xl mx-auto"
                : "grid-cols-1 md:grid-cols-2 lg:grid-cols-3",
          ]}
        >
          {realPosts.map((post, idx) => {
            const postHref = `/blog/${post.slug}`;
            const imageSrc = post.image || "/placeholder.svg";

            return (
              <article
                data-animate="fade-up"
                data-animate-delay={String((idx % 3) * 120)}
                class="group flex flex-col bg-white dark:bg-gray-800 rounded-2xl overflow-hidden shadow-md hover:shadow-2xl border border-gray-100 dark:border-gray-700/60 hover:border-emamut-orange/30 transition-all duration-300 hover:-translate-y-2"
              >
                {/* Image with Tags Badge & Skeleton Shimmer */}
                <div class="relative w-full h-48 overflow-hidden bg-gray-100 dark:bg-gray-950 skeleton-shimmer">
                  <a
                    href={postHref}
                    class="block w-full h-full"
                    aria-label={`Leer artículo: ${post.title}`}
                  >
                    <img
                      src={imageSrc}
                      alt={post.title}
                      class="lazy-img w-full h-full object-cover group-hover:scale-108 transition-all duration-500 ease-out"
                      loading="lazy"
                      decoding="async"
                      onload="this.classList.add('loaded')"
                    />
                  </a>
                  {post.tags && post.tags.length > 0 ? (
                    <div class="absolute top-3 left-3 flex flex-wrap gap-1.5 z-10">
                      {post.tags.map((t) => (
                        <span class="px-3 py-1 text-xs font-semibold rounded-full bg-emamut-orange text-white shadow-md">
                          {t}
                        </span>
                      ))}
                    </div>
                  ) : (
                    post.category && (
                      <span class="absolute top-3 left-3 px-3 py-1 text-xs font-semibold rounded-full bg-emamut-orange text-white shadow-md">
                        {post.category}
                      </span>
                    )
                  )}
                </div>

                {/* Content */}
                <div class="p-6 flex-1 flex flex-col justify-between space-y-4">
                  <div class="space-y-2">
                    <h3 class="text-xl font-bold text-gray-900 dark:text-white group-hover:text-emamut-orange transition-colors duration-200 line-clamp-2">
                      <a href={postHref}>{post.title}</a>
                    </h3>
                    <p class="text-sm text-gray-600 dark:text-gray-300 line-clamp-3 leading-relaxed">
                      {post.excerpt}
                    </p>
                  </div>

                  {/* Author / Date / Read time */}
                  <div class="pt-4 border-t border-gray-100 dark:border-gray-700 flex items-center justify-between text-xs text-gray-500 dark:text-gray-400">
                    <div class="flex items-center space-x-1.5">
                      <Icon
                        name="lucide:user"
                        class="w-3.5 h-3.5 text-emamut-orange"
                      />
                      <span class="truncate max-w-[100px]">{post.author}</span>
                    </div>
                    <div class="flex items-center space-x-3">
                      <div class="flex items-center space-x-1">
                        <Icon name="lucide:calendar" class="w-3.5 h-3.5" />
                        <span>{post.date}</span>
                      </div>
                      <span>•</span>
                      <span>{post.readTime}</span>
                    </div>
                  </div>
                </div>
              </article>
            );
          })}
        </div>
      ) : (
        <div
          data-animate="fade-up"
          class="text-center py-16 bg-white dark:bg-gray-800 rounded-2xl p-8 border border-gray-100 dark:border-gray-700 max-w-lg mx-auto"
        >
          <p class="text-gray-600 dark:text-gray-300">
            Pronto publicaremos nuevos artículos.
          </p>
        </div>
      )
    }

    <!-- CTA Ver todos -->
    <div
      class="text-center mt-12"
      data-animate="fade-up"
      data-animate-delay="150"
    >
      <a
        href="/blog"
        class="group inline-flex items-center gap-2 px-8 py-3.5 rounded-xl font-semibold text-sm border-2 border-emamut-orange text-emamut-orange hover:bg-emamut-orange hover:text-white dark:border-emamut-orange dark:text-emamut-orange hover:-translate-y-0.5 active:translate-y-0 transition-all duration-200"
      >
        <span>Ver Todos los Artículos</span>
        <Icon
          name="lucide:arrow-right"
          class="w-4 h-4 group-hover:translate-x-1 transition-transform"
        />
      </a>
    </div>
  </div>
</section>
