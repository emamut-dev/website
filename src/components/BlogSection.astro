---
import { Icon } from 'astro-icon/components';

interface DatoThumbnail {
  responsiveImage?: {
    src?: string;
    srcSet?: string;
    width?: number;
    height?: number;
    alt?: string;
  };
}

interface BlogPost {
  title: string;
  slug: string;
  content?: string;
  thumbnail?: DatoThumbnail;
  excerpt?: string;
  author?: string;
  date?: string;
  readTime?: string;
  category?: string;
  image?: string;
}

interface Props {
  posts?: BlogPost[];
}

const { posts = [] } = Astro.props;

// Artículos de demostración complementarios según el rediseño
const mockPosts: BlogPost[] = [
  {
    title: 'El Futuro del Desarrollo Web con Next.js y Astro',
    slug: 'futuro-desarrollo-web',
    excerpt: 'Exploramos las nuevas características de las arquitecturas híbridas y cómo optimizar la velocidad de carga al máximo.',
    author: 'Carlos Mendoza',
    date: '15 Nov 2024',
    readTime: '5 min',
    category: 'Desarrollo Web',
    image: '/placeholder.svg',
  },
  {
    title: 'Microservicios vs Monolitos Modulares: ¿Cuál Elegir?',
    slug: 'microservicios-vs-monolitos',
    excerpt: 'Analizamos las ventajas, complejidades y costos de cada arquitectura para ayudarte a tomar la mejor decisión tecnológica.',
    author: 'Ana García',
    date: '12 Nov 2024',
    readTime: '8 min',
    category: 'Arquitectura',
    image: '/placeholder.svg',
  },
  {
    title: 'Optimización de Performance y Core Web Vitals',
    slug: 'optimizacion-performance-web',
    excerpt: 'Técnicas avanzadas para mejorar el rendimiento de tus aplicaciones y ofrecer una experiencia de usuario impecable.',
    author: 'Luis Rodríguez',
    date: '10 Nov 2024',
    readTime: '6 min',
    category: 'Performance',
    image: '/placeholder.svg',
  },
];

// Si hay artículos de DatoCMS, los mapeamos con sus imágenes y datos
const datoItems: BlogPost[] = posts.map((post, idx) => {
  const plainText = post.content ? post.content.replace(/[#*`_\[\]]/g, '').slice(0, 140) + '...' : '';
  const imgUrl = post.thumbnail?.responsiveImage?.src || '/placeholder.svg';

  return {
    ...post,
    excerpt: post.excerpt || plainText || 'Aprende los conceptos fundamentales para potenciar y blindar tu proyecto digital.',
    author: post.author || 'Equipo Emamut',
    date: post.date || 'Reciente',
    readTime: post.readTime || '4 min',
    category: post.category || 'Ciberseguridad',
    image: imgUrl,
  };
});

// Combinamos: artículos reales primero, y completamos hasta al menos 3 con los complementarios
const combinedPosts: BlogPost[] = [...datoItems];
for (const mock of mockPosts) {
  if (combinedPosts.length >= 3) break;
  if (!combinedPosts.some((p) => p.title === mock.title)) {
    combinedPosts.push(mock);
  }
}
---

<section id="blog" class="py-20 bg-gray-50 dark:bg-gray-800/50 transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emamut-orange/10 text-emamut-orange text-xs font-semibold tracking-wider uppercase mb-3">
        Artículos & Recursos
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-gray-900 dark:text-white tracking-tight">
        Blog Técnico
      </h2>
      <p class="mt-4 text-lg text-gray-600 dark:text-gray-300 leading-relaxed">
        Mantente al día con las últimas tendencias tecnológicas, tutoriales y conocimientos de nuestro equipo de desarrollo.
      </p>
    </div>

    <!-- Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {combinedPosts.map((post) => {
        const postHref = `/blog/${post.slug}`;
        const imageSrc = post.image || '/placeholder.svg';

        return (
          <article class="group flex flex-col bg-white dark:bg-gray-800 rounded-2xl overflow-hidden shadow-lg hover:shadow-2xl border border-gray-100 dark:border-gray-700/60 transition-all duration-300 hover:-translate-y-1">
            <!-- Image with Category Badge -->
            <div class="relative w-full h-48 overflow-hidden bg-gray-100 dark:bg-gray-950">
              <a href={postHref} class="block w-full h-full" aria-label={`Leer artículo: ${post.title}`}>
                <img
                  src={imageSrc}
                  alt={post.title}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                />
              </a>
              {post.category && (
                <span class="absolute top-3 left-3 px-3 py-1 text-xs font-semibold rounded-full bg-emamut-orange text-white shadow-md">
                  {post.category}
                </span>
              )}
            </div>

            <!-- Content -->
            <div class="p-6 flex-1 flex flex-col justify-between space-y-4">
              <div class="space-y-2">
                <h3 class="text-xl font-bold text-gray-900 dark:text-white group-hover:text-emamut-orange transition-colors line-clamp-2">
                  <a href={postHref}>
                    {post.title}
                  </a>
                </h3>
                <p class="text-sm text-gray-600 dark:text-gray-300 line-clamp-3 leading-relaxed">
                  {post.excerpt}
                </p>
              </div>

              <!-- Author / Date / Read time -->
              <div class="pt-4 border-t border-gray-100 dark:border-gray-700 flex items-center justify-between text-xs text-gray-500 dark:text-gray-400">
                <div class="flex items-center space-x-1.5">
                  <Icon name="lucide:user" class="w-3.5 h-3.5 text-emamut-orange" />
                  <span class="truncate max-w-[100px]">{post.author}</span>
                </div>
                <div class="flex items-center space-x-3">
                  <div class="flex items-center space-x-1">
                    <Icon name="lucide:calendar" class="w-3.5 h-3.5" />
                    <span>{post.date}</span>
                  </div>
                  <span>•</span>
                  <span>{post.readTime}</span>
                </div>
              </div>
            </div>
          </article>
        );
      })}
    </div>

    <!-- CTA Ver todos -->
    <div class="text-center mt-12">
      <a
        href="/blog"
        class="inline-flex items-center gap-2 px-8 py-3.5 rounded-xl font-semibold text-sm border-2 border-emamut-orange text-emamut-orange hover:bg-emamut-orange hover:text-white dark:border-emamut-orange dark:text-emamut-orange transition-all duration-200"
      >
        <span>Ver Todos los Artículos</span>
        <Icon name="lucide:arrow-right" class="w-4 h-4" />
      </a>
    </div>
  </div>
</section>
