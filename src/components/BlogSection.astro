---
import { Icon } from "astro-icon/components";

interface DatoThumbnail {
  responsiveImage?: {
    src?: string;
    srcSet?: string;
    width?: number;
    height?: number;
    alt?: string;
  };
}

interface BlogPost {
  title: string;
  slug: string;
  content?: string;
  thumbnail?: DatoThumbnail;
  excerpt?: string;
  author?: string;
  date?: string;
  readTime?: string;
  category?: string;
  tags?: string[] | string;
  image?: string;
}

interface Props {
  posts?: BlogPost[];
}

const { posts = [] } = Astro.props;

// Parser para procesar el campo tags de DatoCMS
const parseTags = (tags?: string[] | string): string[] => {
  if (!tags) return [];
  if (Array.isArray(tags)) return tags.map((t) => String(t).trim()).filter(Boolean);
  if (typeof tags === "string") {
    return tags
      .split(/[,;\n]+/)
      .map((t) => t.trim())
      .filter((t) => t.length > 0);
  }
  return [];
};

// Mapeo exclusivo de artículos reales de DatoCMS
const realPosts = posts.map((post) => {
  const plainText = post.content
    ? post.content.replace(/[#*`_\[\]]/g, "").slice(0, 140) + "..."
    : "";
  const imgUrl = post.thumbnail?.responsiveImage?.src || "/placeholder.svg";
  const parsedTags = parseTags(post.tags);

  return {
    ...post,
    excerpt:
      post.excerpt ||
      plainText ||
      "Aprende los conceptos fundamentales para potenciar y blindar tu proyecto digital.",
    author: post.author || "Equipo Emamut",
    date: post.date || "Reciente",
    readTime: post.readTime || "4 min",
    category: parsedTags.length > 0 ? parsedTags[0] : (post.category || "Tecnología"),
    tags: parsedTags,
    image: imgUrl,
  };
});
---

<section
  id="blog"
  class="py-20 bg-pumice dark:bg-obsidian transition-colors"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto space-y-4" data-animate="fade-up">
      <div
        class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-sulfur text-obsidian text-xs font-semibold tracking-wider uppercase"
      >
        Artículos &middot; Recursos Técnicos
      </div>
      <h2
        class="display-title text-4xl sm:text-6xl lg:text-7xl uppercase text-obsidian dark:text-chalk"
      >
        Blog Técnico
      </h2>
      <p class="text-base sm:text-lg text-obsidian/80 dark:text-limestone/80 leading-relaxed font-medium">
        Mantente al día con nuestras guías sobre arquitectura moderna, desarrollo
        de software escalable y estrategias tecnológicas para empresas.
      </p>
    </div>

    <!-- Grid -->
    {
      realPosts.length > 0 ? (
        <div
          class:list={[
            "grid gap-8",
            realPosts.length === 1
              ? "grid-cols-1 max-w-md mx-auto"
              : realPosts.length === 2
                ? "grid-cols-1 md:grid-cols-2 max-w-4xl mx-auto"
                : "grid-cols-1 md:grid-cols-2 lg:grid-cols-3",
          ]}
        >
          {realPosts.map((post, idx) => {
            const postHref = `/blog/${post.slug}`;
            const imageSrc = post.image || "/placeholder.svg";

            return (
              <article
                data-animate="fade-up"
                data-animate-delay={String((idx % 3) * 120)}
                class="group flex flex-col bg-limestone dark:bg-[#141314] rounded-[40px] p-6 sm:p-8 border border-obsidian/10 dark:border-white/10 transition-transform hover:-translate-y-1.5 duration-300"
              >
                {/* Image with 28px radius */}
                <div class="relative w-full h-52 rounded-[28px] overflow-hidden bg-obsidian/5 dark:bg-obsidian skeleton-shimmer mb-6">
                  <a
                    href={postHref}
                    class="block w-full h-full"
                    aria-label={`Leer artículo: ${post.title}`}
                  >
                    <img
                      src={imageSrc}
                      alt={post.title}
                      class="lazy-img w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
                      loading="lazy"
                      decoding="async"
                      onload="this.classList.add('loaded')"
                    />
                  </a>
                  {post.tags && post.tags.length > 0 ? (
                    <div class="absolute top-3 left-3 flex flex-wrap gap-1.5 z-10">
                      {post.tags.map((t) => (
                        <span class="px-3 py-1 text-xs font-medium rounded-full bg-sulfur text-obsidian">
                          {t}
                        </span>
                      ))}
                    </div>
                  ) : (
                    post.category && (
                      <span class="absolute top-3 left-3 px-3 py-1 text-xs font-medium rounded-full bg-sulfur text-obsidian">
                        {post.category}
                      </span>
                    )
                  )}
                </div>

                {/* Content */}
                <div class="flex-1 flex flex-col justify-between space-y-4">
                  <div class="space-y-3">
                    <h3 class="display-title text-2xl sm:text-3xl uppercase text-obsidian dark:text-chalk group-hover:text-ember transition-colors line-clamp-2">
                      <a href={postHref}>{post.title}</a>
                    </h3>
                    <p class="text-sm text-obsidian/75 dark:text-limestone/75 line-clamp-3 leading-relaxed font-medium">
                      {post.excerpt}
                    </p>
                  </div>

                  {/* Author / Date / Read time */}
                  <div class="pt-4 border-t border-dotted border-obsidian/15 dark:border-white/15 flex items-center justify-between text-xs text-obsidian/60 dark:text-limestone/60">
                    <div class="flex items-center space-x-1.5 font-medium">
                      <Icon
                        name="lucide:user"
                        class="w-3.5 h-3.5 text-ember"
                      />
                      <span class="truncate max-w-[100px]">{post.author}</span>
                    </div>
                    <div class="flex items-center space-x-3 font-medium">
                      <div class="flex items-center space-x-1">
                        <Icon name="lucide:calendar" class="w-3.5 h-3.5" />
                        <span>{post.date}</span>
                      </div>
                      <span>&middot;</span>
                      <span>{post.readTime}</span>
                    </div>
                  </div>
                </div>
              </article>
            );
          })}
        </div>
      ) : (
        <div
          data-animate="fade-up"
          class="text-center py-16 bg-limestone dark:bg-[#141314] rounded-[40px] p-8 border border-obsidian/10 dark:border-white/10 max-w-lg mx-auto"
        >
          <p class="text-obsidian/75 dark:text-limestone/75 font-medium">
            Pronto publicaremos nuevos artículos.
          </p>
        </div>
      )
    }

    <!-- CTA Ver todos (Secondary Pill Button) -->
    <div
      class="text-center pt-4"
      data-animate="fade-up"
      data-animate-delay="150"
    >
      <a
        href="/blog"
        class="inline-flex items-center justify-center gap-2.5 px-8 py-3.5 rounded-full font-medium text-base border-[1.5px] border-obsidian dark:border-limestone text-obsidian dark:text-limestone hover:bg-obsidian hover:text-chalk dark:hover:bg-limestone dark:hover:text-obsidian transition-colors"
      >
        <span>Ver Todos los Artículos</span>
        <Icon name="lucide:arrow-right" class="w-4 h-4" />
      </a>
    </div>
  </div>
</section>
