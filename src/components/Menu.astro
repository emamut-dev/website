---
import { Icon } from 'astro-icon/components';
import ThemeToggle from './ThemeToggle.astro';
---

<header class="fixed top-0 left-0 right-0 z-50 bg-white/90 dark:bg-gray-900/90 backdrop-blur-md border-b border-gray-200 dark:border-gray-800 transition-colors duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      <!-- Logo de Emamut -->
      <a href="/#hero" class="flex items-center focus:outline-none" aria-label="Ir al inicio de Emamut">
        <img
          src="/logo-emamut.png"
          alt="Emamut Logo"
          class="h-8 md:h-16 w-auto dark:brightness-0 dark:invert transition-all"
          loading="eager"
        />
      </a>

      <!-- Navegación Desktop -->
      <nav class="hidden md:flex items-center space-x-8" aria-label="Navegación principal">
        <a
          href="/#hero"
          class="text-sm font-medium text-gray-700 dark:text-gray-300 hover:text-emamut-orange dark:hover:text-emamut-orange transition-colors"
        >
          Inicio
        </a>
        <a
          href="/#portfolio"
          class="text-sm font-medium text-gray-700 dark:text-gray-300 hover:text-emamut-orange dark:hover:text-emamut-orange transition-colors"
        >
          Portfolio
        </a>
        <a
          href="/#blog"
          class="text-sm font-medium text-gray-700 dark:text-gray-300 hover:text-emamut-orange dark:hover:text-emamut-orange transition-colors"
        >
          Blog
        </a>
        <a
          href="/#contact"
          class="text-sm font-medium text-gray-700 dark:text-gray-300 hover:text-emamut-orange dark:hover:text-emamut-orange transition-colors"
        >
          Contacto
        </a>
        <ThemeToggle />
      </nav>

      <!-- Botones Mobile: Theme Toggle y Menú Hamburguesa -->
      <div class="flex items-center space-x-2 md:hidden">
        <ThemeToggle />
        <button
          type="button"
          id="mobile-menu-btn"
          class="p-2 rounded-xl text-gray-700 dark:text-gray-300 hover:text-emamut-orange dark:hover:text-emamut-orange hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors focus:outline-none focus:ring-2 focus:ring-emamut-orange/50 cursor-pointer"
          aria-label="Abrir menú de navegación"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <span id="menu-icon-open" class="block">
            <Icon name="lucide:menu" class="w-6 h-6" />
          </span>
          <span id="menu-icon-close" class="hidden">
            <Icon name="lucide:x" class="w-6 h-6" />
          </span>
        </button>
      </div>
    </div>
  </div>

  <!-- Panel Desplegable Móvil -->
  <div
    id="mobile-menu"
    class="hidden md:hidden border-b border-gray-200 dark:border-gray-800 bg-white/98 dark:bg-gray-900/98 backdrop-blur-xl px-4 pt-3 pb-6 space-y-3 transition-all"
  >
    <a
      href="/#hero"
      class="mobile-nav-link block px-3 py-2.5 rounded-xl text-base font-medium text-gray-800 dark:text-gray-200 hover:bg-emamut-orange/10 hover:text-emamut-orange dark:hover:text-emamut-orange transition-colors"
    >
      Inicio
    </a>
    <a
      href="/#portfolio"
      class="mobile-nav-link block px-3 py-2.5 rounded-xl text-base font-medium text-gray-800 dark:text-gray-200 hover:bg-emamut-orange/10 hover:text-emamut-orange dark:hover:text-emamut-orange transition-colors"
    >
      Portfolio
    </a>
    <a
      href="/#blog"
      class="mobile-nav-link block px-3 py-2.5 rounded-xl text-base font-medium text-gray-800 dark:text-gray-200 hover:bg-emamut-orange/10 hover:text-emamut-orange dark:hover:text-emamut-orange transition-colors"
    >
      Blog
    </a>
    <a
      href="/#contact"
      class="mobile-nav-link block px-3 py-2.5 rounded-xl text-base font-medium text-gray-800 dark:text-gray-200 hover:bg-emamut-orange/10 hover:text-emamut-orange dark:hover:text-emamut-orange transition-colors"
    >
      Contacto
    </a>

    <!-- Fila de cambio de tema dentro del menú desplegable -->
    <div class="pt-3 border-t border-gray-100 dark:border-gray-800 flex items-center justify-between px-3">
      <span class="text-sm font-medium text-gray-600 dark:text-gray-400">Tema del sitio</span>
      <ThemeToggle showLabel={true} class="bg-gray-100 dark:bg-gray-800 px-3 py-1.5" />
    </div>
  </div>
</header>

<script is:inline>
  (() => {
    const initMenu = () => {
      const btn = document.getElementById('mobile-menu-btn');
      const menu = document.getElementById('mobile-menu');
      const iconOpen = document.getElementById('menu-icon-open');
      const iconClose = document.getElementById('menu-icon-close');
      const navLinks = document.querySelectorAll('.mobile-nav-link');

      if (!btn || !menu || !iconOpen || !iconClose) return;

      const toggleMenu = () => {
        const isExpanded = btn.getAttribute('aria-expanded') === 'true';
        btn.setAttribute('aria-expanded', String(!isExpanded));
        menu.classList.toggle('hidden');
        iconOpen.classList.toggle('hidden');
        iconClose.classList.toggle('hidden');
      };

      const closeMenu = () => {
        btn.setAttribute('aria-expanded', 'false');
        menu.classList.add('hidden');
        iconOpen.classList.remove('hidden');
        iconClose.classList.add('hidden');
      };

      btn.onclick = (e) => {
        e.stopPropagation();
        toggleMenu();
      };

      navLinks.forEach((link) => {
        link.onclick = () => closeMenu();
      });

      document.addEventListener('click', (e) => {
        if (!menu.contains(e.target) && !btn.contains(e.target)) {
          closeMenu();
        }
      });
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initMenu);
    } else {
      initMenu();
    }
    document.addEventListener('astro:after-swap', initMenu);
  })();
</script>