---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Portfolio from '../components/Portfolio.astro';
import BlogSection from '../components/BlogSection.astro';
import Contact from '../components/Contact.astro';

import { getFeatures, getPortfolio, getSocialNetworks, getHomePosts } from '../lib/datocms.js';

let allFeatures = [];
let allPortfolios = [];
let allSocialNetworks = [];
let allBlogs = [];

try {
  const featuresRes = await getFeatures();
  allFeatures = featuresRes?.allFeatures || [];
} catch (error) {
  console.warn('Could not fetch features from DatoCMS:', error);
}

try {
  const portfolioRes = await getPortfolio();
  allPortfolios = portfolioRes?.allPortfolios || [];
} catch (error) {
  console.warn('Could not fetch portfolio from DatoCMS:', error);
}

try {
  const socialRes = await getSocialNetworks();
  allSocialNetworks = socialRes?.allSocialNetworks || [];
} catch (error) {
  console.warn('Could not fetch social networks from DatoCMS:', error);
}

try {
  const blogsRes = await getHomePosts();
  allBlogs = blogsRes?.allBlogs || [];
} catch (error) {
  console.warn('Could not fetch home blogs from DatoCMS:', error);
}
---

<Layout title="Inicio">
  <Hero />
  <Portfolio items={allPortfolios} />
  <BlogSection posts={allBlogs} />
  <Contact socialNetworks={allSocialNetworks} />
</Layout>