---
import Layout from "../layouts/Layout.astro";
import CardBlog from "../components/CardBlog.astro";
import { getArchivePosts } from "../lib/datocms.js";

let allBlogs = [];
try {
  const blogsRes = await getArchivePosts();
  allBlogs = blogsRes?.allBlogs || [];
} catch (error) {
  console.warn("Could not fetch archive posts from DatoCMS:", error);
}
---

<Layout
  title="Blog Técnico"
  description="Explora nuestros artículos, tutoriales y análisis sobre tecnología, desarrollo web y ciberseguridad para emprendedores."
>
  <div class="pt-36 pb-24 bg-pumice dark:bg-obsidian transition-colors min-h-[80vh]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
      <div class="text-center max-w-3xl mx-auto space-y-4" data-animate="fade-up">
        <div
          class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-sulfur text-obsidian text-xs font-semibold tracking-wider uppercase"
        >
          Artículos &middot; Archivo Técnico
        </div>
        <h1
          class="display-title text-5xl sm:text-7xl lg:text-8xl uppercase text-obsidian dark:text-chalk"
        >
          Blog Técnico
        </h1>
        <p class="text-base sm:text-lg text-obsidian/80 dark:text-limestone/80 leading-relaxed font-medium">
          Explora nuestros artículos, guías y análisis sobre arquitectura digital,
          desarrollo de software y ciberseguridad para empresas que buscan escalar.
        </p>
      </div>

      {
        allBlogs.length > 0 ? (
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {allBlogs.map(({ title, thumbnail, slug, content, tags }, idx) => (
              <CardBlog
                thumbnail={thumbnail}
                title={title}
                slug={slug}
                content={content}
                tags={tags}
                delay={(idx % 3) * 120}
              />
            ))}
          </div>
        ) : (
          <div
            data-animate="fade-up"
            class="text-center py-16 bg-limestone dark:bg-[#141314] rounded-[40px] p-8 border border-obsidian/10 dark:border-white/10 max-w-lg mx-auto"
          >
            <p class="text-obsidian/75 dark:text-limestone/75 font-medium">
              Pronto publicaremos nuevos artículos.
            </p>
          </div>
        )
      }
    </div>
  </div>
</Layout>
