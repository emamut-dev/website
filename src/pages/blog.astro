---
import Layout from '../layouts/Layout.astro';
import CardBlog from '../components/CardBlog.astro';
import { getArchivePosts } from '../lib/datocms.js';

let allBlogs = [];
try {
  const blogsRes = await getArchivePosts();
  allBlogs = blogsRes?.allBlogs || [];
} catch (error) {
  console.warn('Could not fetch archive posts from DatoCMS:', error);
}
---

<Layout
  title="Blog Técnico"
  description="Explora nuestros artículos, tutoriales y análisis sobre tecnología, desarrollo web y ciberseguridad para emprendedores."
>
  <div class="pt-32 pb-20 bg-gradient-to-b from-gray-50 to-white dark:from-gray-900 dark:to-gray-950 transition-colors min-h-[70vh]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emamut-orange/10 text-emamut-orange text-xs font-semibold tracking-wider uppercase mb-3">
          Artículos & Conocimiento
        </div>
        <h1 class="text-4xl sm:text-5xl font-extrabold text-gray-900 dark:text-white tracking-tight">
          Blog Técnico
        </h1>
        <p class="mt-4 text-lg text-gray-600 dark:text-gray-300 leading-relaxed">
          Explora nuestros artículos, guías y análisis sobre tecnología, desarrollo web, arquitectura digital y ciberseguridad.
        </p>
      </div>

      {allBlogs.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {allBlogs.map(({ title, thumbnail, slug, content }) => (
            <CardBlog thumbnail={thumbnail} title={title} slug={slug} content={content} />
          ))}
        </div>
      ) : (
        <div class="text-center py-16 bg-white dark:bg-gray-800 rounded-2xl p-8 border border-gray-100 dark:border-gray-700 max-w-lg mx-auto">
          <p class="text-gray-600 dark:text-gray-300">Pronto publicaremos nuevos artículos.</p>
        </div>
      )}
    </div>
  </div>
</Layout>